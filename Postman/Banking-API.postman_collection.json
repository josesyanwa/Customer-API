{
  "info": {
    "_postman_id": "c0fd1296-04ac-4ca7-9e67-0db39728b691",
    "name": "Banking API",
    "description": "End-to-end account creation, deposit, transfer, and balance checks. Run the requests in order using the Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create source account",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const runId = Date.now().toString();",
              "pm.collectionVariables.set('sourceAccount', '91' + runId.slice(-8));",
              "pm.collectionVariables.set('destinationAccount', '92' + runId.slice(-8));",
              "pm.collectionVariables.set('depositReference', 'deposit-' + runId);",
              "pm.collectionVariables.set('transferReference', 'transfer-' + runId);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Account created', function () {",
              "    pm.response.to.have.status(201);",
              "    const body = pm.response.json();",
              "    pm.expect(body.accountNumber).to.eql(pm.collectionVariables.get('sourceAccount'));",
              "    pm.expect(body.balance).to.eql('0.00');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"accountNumber\": \"{{sourceAccount}}\",\n  \"customerName\": \"Postman Source\",\n  \"currency\": \"USD\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/accounts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "accounts"
          ]
        }
      }
    },
    {
      "name": "Create destination account",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Destination account created', function () {",
              "    pm.response.to.have.status(201);",
              "    const body = pm.response.json();",
              "    pm.expect(body.accountNumber).to.eql(pm.collectionVariables.get('destinationAccount'));",
              "    pm.expect(body.balance).to.eql('0.00');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"accountNumber\": \"{{destinationAccount}}\",\n  \"customerName\": \"Postman Destination\",\n  \"currency\": \"USD\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/accounts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "accounts"
          ]
        }
      }
    },
    {
      "name": "Record deposit",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Deposit recorded', function () {",
              "    pm.response.to.have.status(201);",
              "    const body = pm.response.json();",
              "    pm.expect(body.type).to.eql('DEPOSIT');",
              "    pm.expect(body.status).to.eql('COMPLETED');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"referenceId\": \"{{depositReference}}\",\n  \"accountNumber\": \"{{sourceAccount}}\",\n  \"amount\": 100.00,\n  \"type\": \"DEPOSIT\",\n  \"description\": \"Postman test deposit\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/transactions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "transactions"
          ]
        }
      }
    },
    {
      "name": "Transfer funds",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Transfer completed', function () {",
              "    pm.response.to.have.status(201);",
              "    const body = pm.response.json();",
              "    pm.expect(body.type).to.eql('TRANSFER');",
              "    pm.expect(body.status).to.eql('COMPLETED');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"referenceId\": \"{{transferReference}}\",\n  \"sourceAccountNumber\": \"{{sourceAccount}}\",\n  \"destinationAccountNumber\": \"{{destinationAccount}}\",\n  \"amount\": 25.00\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/transfers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "transfers"
          ]
        }
      }
    },
    {
      "name": "Get source balance",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Source balance is 75.00 USD', function () {",
              "    pm.response.to.have.status(200);",
              "    const body = pm.response.json();",
              "    pm.expect(body.accountNumber).to.eql(pm.collectionVariables.get('sourceAccount'));",
              "    pm.expect(body.balance).to.eql('75.00');",
              "    pm.expect(body.currency).to.eql('USD');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/accounts/{{sourceAccount}}/balance",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "accounts",
            "{{sourceAccount}}",
            "balance"
          ]
        }
      }
    },
    {
      "name": "Get destination balance",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Destination balance is 25.00 USD', function () {",
              "    pm.response.to.have.status(200);",
              "    const body = pm.response.json();",
              "    pm.expect(body.accountNumber).to.eql(pm.collectionVariables.get('destinationAccount'));",
              "    pm.expect(body.balance).to.eql('25.00');",
              "    pm.expect(body.currency).to.eql('USD');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/accounts/{{destinationAccount}}/balance",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "accounts",
            "{{destinationAccount}}",
            "balance"
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    }
  ]
}
